# PostgreSQL. With Docker: `docker compose up -d` uses these credentials.
DATABASE_URL=postgres://saas:saas@localhost:5432/saas_starter

# Tests create and drop a throwaway database on this server (the user needs CREATEDB).
TEST_DATABASE_URL=postgres://saas:saas@localhost:5432/postgres

# Public URL of the app, used in invite links and Stripe redirects.
APP_URL=http://localhost:3000

# Optional: Stripe billing. Leave blank to run on the free plan only.
# Use a restricted API key (rk_...) from a Stripe sandbox, not a live secret key.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
